[Unit]
Description=Spacious Africa (Django)
After=network.target

[Service]
Type=simple
User=gift
WorkingDirectory=/home/gift/projects/spaciousafrica
EnvironmentFile=/home/gift/projects/spaciousafrica/.env
ExecStart=/home/gift/projects/spaciousafrica/venv/bin/gunicorn spaciousafrica.wsgi:application -b 127.0.0.1:8020 --workers 3
Restart=on-failure

[Install]
WantedBy=multi-user.target
